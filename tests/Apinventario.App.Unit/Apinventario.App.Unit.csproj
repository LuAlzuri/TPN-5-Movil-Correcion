<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><IsTestProject>true</IsTestProject><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2"><PrivateAssets>all</PrivateAssets></PackageReference>
    <!-- Test the actual portable source, with no Android workload/device dependency. -->
    <Compile Include="../../Apinventario.App/Models/Common/*.cs" Link="Source/Common/%(Filename)%(Extension)" />
    <Compile Include="../../Apinventario.App/Models/Administracion/*.cs" Link="Source/Admin/%(Filename)%(Extension)" />
    <Compile Include="../../Apinventario.App/Services/Infrastructure/*.cs" Exclude="../../Apinventario.App/Services/Infrastructure/TokenStore.cs;../../Apinventario.App/Services/Infrastructure/PlatformServices.cs" Link="Source/Infrastructure/%(Filename)%(Extension)" />
    <Compile Include="../../Apinventario.App/Services/Administracion/*.cs" Link="Source/Services/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
