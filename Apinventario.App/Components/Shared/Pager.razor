<nav aria-label="Paginación" class="pager">
    <button class="btn btn-outline-secondary" disabled="@(Busy || Page <= 1)" @onclick="() => Change.InvokeAsync(Page - 1)">Anterior</button>
    <span>Página @Page de @Math.Max(1, Pages) · @Total registros</span>
    <button class="btn btn-outline-secondary" disabled="@(Busy || Page >= Pages)" @onclick="() => Change.InvokeAsync(Page + 1)">Siguiente</button>
</nav>
@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int Pages { get; set; }
    [Parameter] public int Total { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<int> Change { get; set; }
}
